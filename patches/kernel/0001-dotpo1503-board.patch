+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/* DOTPO1503: hardware data transcribed from the stock Android boot DTB. */
+#include "rk3288-evb-rk808.dts"
+
+/ {
+    model = "DOTPO1503";
+    compatible = "dotpo,dotpo1503", "rockchip,rk3288";
+
+    chosen {
+        stdout-path = "serial4:115200n8";
+    };
+
+    vcc_otg_vbus: regulator-otg-vbus {
+        compatible = "regulator-fixed";
+        regulator-name = "vcc_otg_vbus";
+        enable-active-high;
+        gpio = <&gpio0 RK_PB4 GPIO_ACTIVE_HIGH>;
+        pinctrl-names = "default";
+        pinctrl-0 = <&otg_vbus_drv>;
+    };
+};
+
+&backlight {
+    default-brightness-level = <180>;
+    pwms = <&pwm0 0 1000000 0>;
+};
+
+&panel {
+    compatible = "dotpo,dotpo1503-panel";
+    enable-gpios = <&gpio7 RK_PA3 GPIO_ACTIVE_HIGH>;
+    pinctrl-names = "default";
+    pinctrl-0 = <&lcd_cs>;
+    no-hpd;
+};
+
+&lcd_cs {
+    rockchip,pins = <7 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
+};
+
+&edp {
+    status = "okay";
+};
+
+&gmac {
+    phy-mode = "rmii";
+    snps,reset-gpio = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
+    snps,reset-delays-us = <0 10000 50000>;
+    pinctrl-0 = <&rmii_pins>;
+    max-speed = <1000>;
+};
+
+&vcc_host {
+    gpio = <&gpio0 RK_PB5 GPIO_ACTIVE_HIGH>;
+};
+
+&host_vbus_drv {
+    rockchip,pins = <0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
+};
+
+&pinctrl {
+    usb {
+        otg_vbus_drv: otg-vbus-drv {
+            rockchip,pins = <0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
+        };
+    };
+};
+
+&usb_otg {
+    vbus-supply = <&vcc_otg_vbus>;
+    status = "okay";
+};
+
+&usb_host0_ohci {
+    status = "okay";
+};
+
+/* Stock RK808 SWITCH_REG1 feeds the SD slot; the EVB GPIO regulator does not. */
+&vcc_sd {
+    status = "disabled";
+};
+
+&vcc_wl {
+    regulator-name = "vcc_sd";
+};
+
+&sdmmc {
+    vmmc-supply = <&vcc_wl>;
+};
+
+/* RK808 LDO names and voltages differ from the reference EVB wiring. */
+&rk808 {
+    vcc8-supply = <&vcc_io>;
+    vcc9-supply = <&vcc_io>;
+    vcc12-supply = <&vcc_io>;
+    vddio-supply = <&vcc_io>;
+};
+
+&vccio_pmu {
+    regulator-name = "vcc_tp";
+};
+
+&vcc_tp {
+    regulator-name = "vcca_codec";
+};
+
+&vcc18_lcd {
+    regulator-name = "vcc_wl";
+    regulator-min-microvolt = <1800000>;
+    regulator-max-microvolt = <1800000>;
+};
+
+&vcca_codec {
+    regulator-name = "vcc18_lcd";
+    regulator-min-microvolt = <1800000>;
+    regulator-max-microvolt = <1800000>;
+};
